    "code": "import sqlite3\nconn = sqlite3.connect('magaza.db')\ncur = conn.cursor()\n\n# Sorguyu test et\nquery = \"\"\"\nWITH \nsehirler AS (\n    SELECT DISTINCT sehir FROM musteriler\n),\nsiparis_ciro AS (\n    SELECT \n        m.sehir,\n        COUNT(DISTINCT m.id) AS musteri_sayisi,\n        ROUND(COALESCE(SUM(sk.adet * sk.birim_fiyat), 0), 2) AS toplam_ciro\n    FROM musteriler m\n    LEFT JOIN siparisler s ON s.musteri_id = m.id\n    LEFT JOIN siparis_kalemleri sk ON sk.siparis_id = s.id\n    GROUP BY m.sehir\n)\nSELECT \n    sl.sehir,\n    COALESCE(sc.musteri_sayisi, 0) AS musteri_sayisi,\n    COALESCE(sc.toplam_ciro, 0.0) AS toplam_ciro\nFROM sehirler sl\nLEFT JOIN siparis_ciro sc ON sc.sehir = sl.sehir\nORDER BY toplam_ciro DESC, sehir ASC;\n\"\"\"\n\ncur.execute(query)\nresults = cur.fetchall()\nfor row in results:\n    print(row)\n\nconn.close()\n",
